# Copy to .env and edit
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sanjivani
# Frontend origin(s) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:3000

# Admin panel sign-in. JWT_SECRET must be a long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# First admin account, created on start-up only if no admin exists yet.
# Remove ADMIN_PASSWORD from this file after the first start. (Or use: npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional shared key for scripts (send as header: x-admin-key)
ADMIN_KEY=
# Folder for uploaded product images (served at /uploads)
UPLOAD_DIR=uploads

# Copy this file to .env.local (for npm run dev) and fill it in.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- Database: MongoDB Atlas (free M0 cluster is enough) ---
# Atlas > your cluster > Connect > Drivers. Put the database name after the host, e.g. /sanjivani
MONGODB_URI=mongodb+srv://sohamkale3014_db_user:C09ZD2MWlRXP2JeD@cluster0.nltizqs.mongodb.net/?appName=Cluster0
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sanjivani?retryWrites=true&w=majority
# --- Admin panel sign-in ---
# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# First admin account, created at the first sign-in if no admin exists yet.
# You can remove ADMIN_PASSWORD afterwards and change the password in the admin panel.
# (Or use: npm run create-admin -- you@example.com "a-long-password")
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional shared key for scripts (sent as header: x-admin-key)
ADMIN_KEY=

# --- Product photos: Cloudinary (free plan) ---
# Cloudinary dashboard > API Keys > "API environment variable", in the form
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder the photos go into
CLOUDINARY_FOLDER=sanjivani

# --- Enquiry emails: Resend (free plan) ---
# resend.com > API Keys
RESEND_API_KEY=
# Where franchise, dealer, contact and order enquiries are sent (comma separated)
ENQUIRY_EMAIL_TO=sanjivaniofficial@gmail.com
# Sender. onboarding@resend.dev only delivers to the email you signed up to Resend with;
# after verifying your own domain in Resend use e.g.: Sanjivani Website <enquiry@yourdomain.com>
ENQUIRY_EMAIL_FROM=Sanjivani Website <onboarding@resend.dev>

# --- Website address (used for links shared on WhatsApp/Google) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty: the API is part of this app. Only set it if the API is hosted on another domain.
NEXT_PUBLIC_API_URL=
